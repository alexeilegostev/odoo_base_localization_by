<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="report_tn_horizontal_pick">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="base_localization_by.report_tn_pick" t-lang="o.partner_id.lang"/>
                </t>
            </t>
        </template>

        <template id="report_tn_vertical_pick">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="base_localization_by.report_tn_pick" t-lang="o.partner_id.lang"/>
                </t>
            </t>
        </template>

        <template id="report_tn_pick">
            <t t-call="web.basic_layout">
                <style>
                     div {
                            font-family: Verdana, Arial, Helvetica, sans-serif;
                            font-size: 6pt;
                        }
                        .bol_table {border: 1px solid black; width: 100%; display:table; border-spacing: 0;}
                        .bol_table th {border: 1px solid black; height: 16px; border-spacing: 0; padding: 0.2em; font-wight:bold; text-align: center; padding: 0px 3px 0px 3px; vertical-align: middle;}
                        .bol_table td {border: 1px solid black; text-align:right; height: 13px; vertical-align: bottom;}
                        .unp_table {border: 0px; width: 40%; margin-left: auto; margin-right: auto;}
                        .vat_table td {padding: 5px;}
                        .upper_note {border-top: 1px solid black; font-size: xx-small; text-align: center;}
                        .span_style_x {white-space: pre; font-size: x-small; line-height: 9px;}
                        .span_style_x_partner {font-size: x-small; line-height: 9px;}
                        .span_style_xx {white-space: pre; font-size: xx-small; line-height: 10px;}
                        .bottom_x {margin-bottom: 0px !important;}
                        .bottom_x_ {margin-bottom: 3px !important;}
                        .bottom_xx {margin-bottom: 8px !important;}

                </style>
                <div class="page">
                    <br/>
                    <br/>
                    <table class="unp_table" cellspacing="0" cellpadding="5">
                        <tbody>
                            <tr>
                                <td style="border: 0px; width: 30px;"/>
                                <td style="width: 180px; text-align: center; border: 1px solid black;">
                                    Грузоотправитель
                                </td>
                                <td style="width: 180px; text-align: center; border: 1px solid black;">Грузополучатель
                                </td>
                            </tr>
                            <tr>
                                <td style="border: 0px; text-align: center;">УНП</td>
                                <td style="text-align: center; border: 1px solid black;">
                                    <span t-if="o.company_id.partner_id.vat" t-esc="o.company_id.partner_id.vat"
                                          t-attf-class="span_style_x"/>
                                </td>
                                <td style="text-align: center; border: 1px solid black;">
                                    <span t-if="o.partner_id.vat" t-esc="o.partner_id.vat" t-attf-class="span_style_x"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <br/>
                    <br/>
                    <br/>
                    <br/>
                    <br/>
                    <br/>
                    <br/>
                    <br/>
                    <br/>
                    <br/>
                    <br/>
                    <br/>
                    <br/>
                    <br/>

                    <table style="border: 0px; width: 100%">
                        <tr>
                            <td style="height: 18px; text-align: left;">
                                <t t-esc="helper.ru_date_short(o.scheduled_date)"/>
                            </td>
                        </tr>
                    </table>
                    <table class="bottom_x" style="width:100%;" cellspacing="0">
                        <tbody>
                            <tr>
                                <td style="white-space: pre; padding-right: 5px;"><span class="span_style_x">Грузоотправитель</span></td>
                                <td style="width: 100%;">
                                    <span class="span_style_x_partner">
                                        <t t-esc="o.company_id.name"/>
                                        <span t-esc="o.company_id.zip"/>
                                        <span t-esc="o.company_id.country_id.name"/>
                                        <span t-esc="o.company_id.state_id.name"/>
                                        <span t-esc="o.company_id.city"/>
                                        <span t-esc="o.company_id.street"/>
                                        <span t-esc="o.company_id.street2"/>
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <td/>
                                <td class="upper_note">(наименование, адрес)</td>
                            </tr>
                        </tbody>
                    </table>
                    <table class="bottom_x" style="width:100%;" cellspacing="0">
                        <tbody>
                            <tr>
                                <td style="white-space: pre; padding-right: 5px;"><span class="span_style_x">Грузополучатель</span></td>
                                <td style="width: 100%;">
                                    <span class="span_style_x_partner">
                                        <t t-if="o.sale_order_id.partner_invoice_id">
                                            <t t-esc="o.sale_order_id.partner_invoice_id.name"/>
                                            <span t-esc="o.sale_order_id.partner_invoice_id.zip"/>
                                            <span t-esc="o.sale_order_id.partner_invoice_id.country_id.name"/>
                                            <span t-esc="o.sale_order_id.partner_invoice_id.state_id.name"/>
                                            <span t-esc="o.sale_order_id.partner_invoice_id.city"/>
                                            <span t-esc="o.sale_order_id.partner_invoice_id.street"/>
                                            <span t-esc="o.sale_order_id.partner_invoice_id.street2"/>
                                        </t>
                                        <t t-else="">
                                            <t t-esc="o.partner_id.name"/>
                                            <span t-esc="o.partner_id.zip"/>
                                            <span t-esc="o.partner_id.country_id.name"/>
                                            <span t-esc="o.partner_id.state_id.name"/>
                                            <span t-esc="o.partner_id.city"/>
                                            <span t-esc="o.partner_id.street"/>
                                            <span t-esc="o.partner_id.street2"/>
                                        </t>
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <td/>
                                <td class="upper_note">(наименование, адрес)</td>
                            </tr>
                        </tbody>
                    </table>

                    <table  class="bottom_x" style="width:100%;" cellspacing="0">
                        <tr>
                            <td style="white-space: pre; padding-right: 5px;"><span class="span_style_x">Основание отпуска</span></td>
                            <td style="width:88%;">
                                <t t-if="o.basis_document">
                                    <t t-if="o.contract_id"><span>, </span><span t-esc="o.basis_document" class="span_style_x"/></t>
                                    <t t-else="">
                                        <span t-esc="o.basis_document" class="span_style_x"/>
                                    </t>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td style="height: 18px;"/>
                            <td class="upper_note">(наименование, дата и номер документа)</td>
                        </tr>
                    </table>
                    <table class="bol_table">
                        <thead>
                            <tr>
                                <th style="min-width: 30%; max-width: 40%;" colspan="9">I ТОВАРНЫЙ РАЗДЕЛ</th>
                            </tr>
                            <tr>
                                <th style="min-width: 200px; max-width: 40%;">Наименование товара</th>
                                <th>Ед.изм.</th>
                                <th>Количество</th>
                                <th>Цена,
                                    <span t-field="o.currency_id.symbol"/>
                                </th>
                                <th>Стоимость,
                                    <span t-field="o.currency_id.symbol"/>
                                </th>
                                <th>Ставка НДС, %</th>
                                <th>Сумма НДС,
                                    <span t-field="o.currency_id.symbol"/>
                                </th>
                                <th>Стоимость с НДС,
                                    <span t-field="o.currency_id.symbol"/>
                                </th>
                                <th>Примечание</th>
                            </tr>
                            <tr>
                                <th>1</th>
                                <th>2</th>
                                <th>3</th>
                                <th>4</th>
                                <th>5</th>
                                <th>6</th>
                                <th>7</th>
                                <th>8</th>
                                <th>9</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="release_value" t-value="0"/>
                            <tr t-foreach="o.move_ids_without_package" t-as="l">
                                <t t-set="release_value" t-value="release_value + l.price_subtotal"
                                   groups="account.group_show_line_subtotals_tax_excluded"/>
                                <t t-set="release_value" t-value="release_value + l.price_total"
                                   groups="account.group_show_line_subtotals_tax_included"/>
                                <td style="min-width: 200px; max-width: 40%; text-align: left;">
                                    <span t-esc="l.name"/>
                                </td>
                                <td style="text-align: center;">
                                    <span t-esc="l.product_uom.name"/>
                                </td>
                                <td style="text-align: right;">
                                    <span t-esc="l.quantity"/>
                                </td>
                                <td style="text-align: right;">
                                    <span t-esc="'%.2f'%  (l.price_unit * (100 - l.discount)/100)"/>
                                </td>
                                <td style="text-align: right;">
                                    <span t-esc="l.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                                    <span t-esc="l.price_total" groups="account.group_show_line_subtotals_tax_included"/>
                                </td>
                                <td style="text-align: center;">
                                    <span t-if="len(l.tax_id)>0"
                                          t-esc="', '.join([str(x) for x in l.tax_id.mapped('amount')])"/>
                                    <span t-if="len(l.tax_id)==0">Без НДС</span>
                                </td>
                                <td style="text-align: right;">
                                    <span t-esc="l.price_tax"/>
                                </td>
                                <td style="text-align: right;">
                                    <span t-esc="l.price_total"/>
                                </td>

                                <td style="text-align: left;">
                                    <span t-field="l.note"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="text-align: left;">ИТОГО</td>
                                <td style="text-align: center;">х</td>
                                <td style="text-align: right;">
                                    <span t-esc="sum(o.move_ids_without_package.mapped('quantity'))"/>
                                </td>
                                <td style="text-align: center;">х</td>
                                <td style="text-align: right;">
                                    <strong>
                                        <span t-esc="'%.2f'% release_value"/>
                                    </strong>
                                </td>
                                <td style="text-align: center;">х</td>
                                <td style="text-align: right;">
                                    <strong>
                                        <span t-esc="o.amount_tax"/>
                                    </strong>
                                </td>
                                <td style="text-align: right;">
                                    <strong>
                                        <span t-esc="o.amount_total"/>
                                    </strong>
                                </td>

                                <td style="text-align: center;">x</td>
                            </tr>
                        </tbody>
                    </table>
                    <br/>
                    <br/>
                    <table class="bottom_x" style="width:100%;" cellspacing="0">
                        <tbody>
                            <tr>
                                <td style="padding-right: 5px;"><span class="span_style_x">Всего сумма НДС</span></td>
                                <td style="width: 100%;">
                                    <span class="span_style_x_partner">
                                        <span t-esc="helper.in_words_with_currency(o.partner_id.lang, o.amount_tax, o.currency_id.name, o.currency_id.currency_unit_label, o.currency_id.currency_subunit_label, True)"/>
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <td/>
                                <td class="upper_note">(прописью)</td>
                            </tr>
                        </tbody>
                    </table>

                    <table class="bottom_x" style="width:100%;" cellspacing="0">
                        <tbody>
                            <tr>
                                <td style="padding-right: 5px;"><span class="span_style_x">Всего стоимость с НДС</span></td>
                                <td style="width: 100%;">
                                    <span class="span_style_x_partner">
                                        <span t-esc="helper.in_words_with_currency(o.partner_id.lang, o.amount_total, o.currency_id.name, o.currency_id.currency_unit_label, o.currency_id.currency_subunit_label, True)"/>
                                        </span>
                                </td>
                            </tr>
                            <tr>
                                <td/>
                                <td class="upper_note">(прописью)</td>
                            </tr>
                        </tbody>
                    </table>
                    <table class="bottom_x" style="width:100%;" cellspacing="0">
                        <tbody>
                            <tr>
                                <td style="padding-right: 5px;"><span class="span_style_x">Отпуск разрешил</span></td>
                                <td style="width: 100%;">
                                    <span class="span_style_x_partner">
                                        <span t-field="o.leave_allowed_by_id"/>
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <td/>
                                <td class="upper_note">(должность, фамилия, инициалы, подпись)</td>
                            </tr>
                        </tbody>
                    </table>
                    <table class="bottom_x" style="width:100%;" cellspacing="0">
                        <tbody>
                            <tr>
                                <td style="padding-right: 5px;"><span class="span_style_x">Сдал грузоотправитель</span></td>
                                <td style="width: 100%;">
                                    <span class="span_style_x_partner">
                                        <span t-if="o.cargo_released_by_id" t-esc="o.cargo_released_by_id.function"
                                        t-attf-class="span_style_x"/>
                                  <span t-if="o.cargo_released_by_id" t-esc="o.cargo_released_by_id.name"
                                         t-attf-class="span_style_x"/>
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <td/>
                                <td class="upper_note">(должность, фамилия, инициалы, подпись)</td>
                            </tr>
                        </tbody>
                    </table>
                    <table class="bottom_x" style="width:100%;" cellspacing="0">
                        <tbody>
                            <tr>
                                <td style="padding-right: 5px;"><span class="span_style_x">Товар к перевозке принял</span></td>
                                <td style="width: 100%;">
                                    <span t-if="o.cargo_accepted_for_transportation_by_id"
                                          t-esc="o.cargo_accepted_for_transportation_by_id.name"
                                          t-attf-class="span_style_x"/>
                                </td>
                            </tr>
                            <tr>
                                <td/>
                                <td class="upper_note">(должность, фамилия, инициалы, подпись)</td>
                            </tr>
                        </tbody>
                    </table>
                    <table class="bottom_x" style="width:100%;" cellspacing="0">
                        <tbody>
                            <tr>
                                <td style="width: 40%;">
                                    <table style="width:100%;" cellspacing="0">
                                        <tbody>
                                            <tr>
                                                <td style="white-space: pre; padding-right: 5px;"><span class="span_style_x">по доверенности</span></td>
                                                <td style="width: 100%;">
                                                    <span><span t-if="o.attorney_number" t-attf-class="span_style_x" t-esc="o.attorney_number"/>
                                                        <t t-if="o.attorney_date">
                                                            <span> от </span> <span t-esc="o.attorney_date"/>
                                                        </t>
                                                </span>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td/>
                                                <td class="upper_note">(номер, дата)</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                                <td style="width: 40%; padding-left: 5px;">
                                    <table style="width:100%;" cellspacing="0">
                                        <tbody>
                                            <tr>
                                                <td style="white-space: pre; padding-right: 5px;"><span class="span_style_x">выданной</span></td>
                                                <td style="width: 100%;">
                                                    <span t-if="o.attorney_company" t-esc="o.attorney_company.name"
                                                      t-attf-class="span_style_x"/>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td/>
                                                <td class="upper_note">(наименование организации)</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>

                            </tr>
                        </tbody>
                    </table>
                    <table class="bottom_x" style="width:100%;" cellspacing="0">
                        <tbody>
                            <tr>
                                <td style="white-space: pre; padding-right: 5px;"><span class="span_style_x">Принял грузополучатель</span></td>
                                <td style="width: 100%;"><span class="span_style_x"/></td>
                            </tr>
                            <tr>
                                <td/>
                                <td class="upper_note">(должность, фамилия, инициалы, подпись, штамп(печать) грузополучателя)</td>
                            </tr>
                        </tbody>
                    </table>
                    <br/>
                </div>
            </t>
        </template>
    </data>
</odoo>
