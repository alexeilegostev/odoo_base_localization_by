<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_company_form_inherit" model="ir.ui.view">
            <field name="name">res.company.form.inherit</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='website']" position="after">
                    <field name="registry_info"/>
                </xpath>
                <xpath expr="//field[@name='currency_id']" position="after">
                    <field invisible="country_id != %(base.ru)d" name="kpp"/>
                    <field name="okpo"/>
                    <field invisible="country_id != %(base.ru)d or company_registry != False" name="ogrnip"/>
                    <field invisible="country_id != %(base.ru)d" name="okato"/>
                </xpath>
                <xpath expr="//field[@name='company_registry']" position="attributes">
                    <attribute name="invisible">ogrnip != False</attribute>
                </xpath></field>
        </record>
    </data>
</odoo>
