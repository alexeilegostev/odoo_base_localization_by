<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="l10n_by_stock_move_line_detailed_operation_tree" model="ir.ui.view">
        <field name="name">l10n_by.stock.move.line.operations.tree</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom_id']" position="after">
                <field name="price_unit" optional="show"/>
                <field name="currency_id" invisible="1"/>
                <field name="discount" optional="show"/>
                <field name="tax_id" optional="show" widget="many2many_tags"/>
                <field name="price_tax" optional="show"/>
                <field name="price_subtotal" optional="show"/>
                <field name="price_total" optional="show"/>
            </xpath>

        </field>
    </record>
</odoo>
